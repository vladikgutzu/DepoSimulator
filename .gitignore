# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Local profiling captures and accidentally bundled installers
/ProfilerCaptures/
/Assets/UnityHubSetup-x64.exe

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.idea/
.codex/
.claude/
.utmp/
.DS_Store

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Portfolio source snapshot: keep authored gameplay code and lightweight data,
# omit commercial art packs, baked lighting, generated media, and local tools.
/Assets/*
!/Assets/WarehouseDemo/
!/Assets/WarehouseDemo/**
!/Assets/WarehouseDemo.meta
!/Assets/Scripts/
!/Assets/Scripts/**
!/Assets/Scripts.meta
!/Assets/Data/
!/Assets/Data/**
!/Assets/Data.meta
!/Assets/Editor/
!/Assets/Editor/**
!/Assets/Editor.meta
!/Assets/Materials/
!/Assets/Materials/**
!/Assets/Materials.meta
!/Assets/Prefabs/
!/Assets/Prefabs/**
!/Assets/Prefabs.meta
!/Assets/Resources/
!/Assets/Resources/**
!/Assets/Resources.meta
!/Assets/Settings/
!/Assets/Settings/**
!/Assets/Settings.meta
!/Assets/Shaders/
!/Assets/Shaders/**
!/Assets/Shaders.meta
!/Assets/Screenshots/
!/Assets/Screenshots/**
!/Assets/Screenshots.meta
!/Assets/WarehouseDemo.unity
!/Assets/WarehouseDemo.unity.meta
!/Assets/DefaultNetworkPrefabs.asset
!/Assets/DefaultNetworkPrefabs.asset.meta
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta
/GeneratedAssets/
/production/
/tmp/
/uam/
/.mcp.json
*.log
/compile_log*.txt
